{
  "name": "tpix",
  "version": "0.0.1",
  "description": "Personal AI virtual office: Boss + 22 role-specialised agents that take an idea and ship it.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:claude": "node --env-file-if-exists=.env --import tsx scripts/smoke-claude.ts",
    "smoke:ollama": "node --env-file-if-exists=.env --import tsx scripts/smoke-ollama.ts",
    "smoke:telegram": "node --env-file-if-exists=.env --import tsx scripts/smoke-telegram.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.30.3",
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "execa": "^9.6.1",
    "fastify": "^5.8.5",
    "grammy": "^1.42.0",
    "pino": "^10.3.1",
    "simple-git": "^3.36.0",
    "yaml": "^2.8.4",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
